TRADIER_API_TOKEN=replace_with_your_tradier_token
TRADIER_ENVIRONMENT=sandbox
# Local default is SQLite when these are unset.
# RESEARCH_REPOSITORY_BACKEND=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database
# APP_PASSWORD=replace_with_demo_password

# Research Conversation Engine provider selection.
# If RCE_PROVIDER is unset, Research Workspace uses the deterministic mock provider.
# RCE_PROVIDER=mock
OPENAI_API_KEY=
RCE_PROVIDER=openai
RCE_OPENAI_MODEL=
RCE_DEBUG_ARTIFACTS=true
# RCE_CONFIDENCE_THRESHOLD=0.70

# Local-only deterministic QA controls. Disabled unless explicitly set true.
# ENABLE_DEVELOPER_TOOLS=true
